# .gitignore for the public datalib mirror.
#
# This file ships to jpazvd/datalib as its .gitignore. Keep it generic: it
# should describe only ordinary build and editor artifacts.
#
# Do not delete it. sync-to-public.yml uses it in preference to the
# development .gitignore, which is not suitable for publication. Rationale
# is recorded on the development side.

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# R
.Rhistory
.RData
.Rproj.user/

# Stata
*.smcl
*.log
