args here
if (`"`here'"'=="") local here "."

import delimited using "`here'/Data/Original/raw_roster.csv", ///
    clear varnames(1) case(preserve)

label data "QMA 2014 XLF v01 master - SYNTHETIC (datalib_makelib)"

label variable hhid "Household identifier"
label variable pid "Person number within household"
label variable age "Age in completed years"
label variable sex "Sex"
