*! ZZA_2022_XHS_v01_M_v01_A_HCL_household.do -- harmonize the household module
*
* Reads   ../ZZA_2022_XHS_v01_M/Data/Stata/ZZA_2022_XHS_v01_M_household.dta
*         (the master; see Data/Original/.provenance)
* Writes  Data/Stata/ZZA_2022_XHS_v01_M_v01_A_HCL_household.dta
*
* Generated by datalib_makelib. The labels below were written FROM the
* generated dataset, so they cannot drift from what it contains.
* The data is synthetic: no value describes a real person or household.

version 15

args here
if (`"`here'"'=="") local here "."

* Input is the master vintage, not a delivery of its own.
use "`here'/../ZZA_2022_XHS_v01_M/Data/Stata/ZZA_2022_XHS_v01_M_household.dta", clear

* --- harmonize: the HCL vocabulary --------------------
* Keys are NEVER renamed. They are the linkage contract, and a
* harmonization that renames them silently breaks every merge that
* module_schema promises. Measures are renamed; keys are preserved.
capture rename region    region_code
capture rename hh_size   hhsize
capture rename hh_weight weight

* --- derive: a categorical the master does not carry ------------
capture confirm variable hhsize
if (_rc==0) {
    gen byte hhsize_grp = 1 + (hhsize>2) + (hhsize>4)
    label define hhsize_grp 1 "1-2" 2 "3-4" 3 "5+", replace
    label values hhsize_grp hhsize_grp
    label variable hhsize_grp "Household size group"
}

* --- harmonized variable and value labels -----------------------
capture label variable hhid        "Household identifier"
capture label variable region_code "Region (harmonized code)"
capture label variable urban       "Urban residence"
capture label variable hhsize      "Household size (persons)"
capture label variable weight      "Sampling weight"

label define hcl_region 1 "North" 2 "East" 3 "South" 4 "West", replace
capture label values region_code hcl_region
label define hcl_urban 0 "Rural" 1 "Urban", replace
capture label values urban hcl_urban

label data "ZZA 2022 XHS v01 adaptation - SYNTHETIC (datalib_makelib)"


* declared structure -- mirrors module_schema: in datalib.yaml
char _dta[datalib_level]      "household"
char _dta[datalib_keys]       "hhid"
char _dta[datalib_parent]     ""
char _dta[datalib_parentkeys] ""

save "`here'/Data/Stata/ZZA_2022_XHS_v01_M_v01_A_HCL_household.dta", replace
