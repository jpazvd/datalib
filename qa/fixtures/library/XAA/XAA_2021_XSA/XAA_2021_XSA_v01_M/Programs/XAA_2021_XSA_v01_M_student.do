* declared structure -- mirrors module_schema: in datalib.yaml
char _dta[datalib_level]      "student"
char _dta[datalib_keys]       "schid clsid stuid"
char _dta[datalib_parent]     "classroom"
char _dta[datalib_parentkeys] "schid clsid"

save "`here'/Data/Stata/XAA_2021_XSA_v01_M_student.dta", replace
