*! XAA_2015_XHS_v01_M_v01_A_HCL_roster.do -- harmonize the roster module
*
* Reads   ../XAA_2015_XHS_v01_M/Data/Stata/XAA_2015_XHS_v01_M_roster.dta
*         (the master; see Data/Original/.provenance)
* Writes  Data/Stata/XAA_2015_XHS_v01_M_v01_A_HCL_roster.dta
*
* Generated by datalib_makelib. The labels below were written FROM the
* generated dataset, so they cannot drift from what it contains.
* The data is synthetic: no value describes a real person or household.

version 15

args here
if (`"`here'"'=="") local here "."

* Input is the master vintage, not a delivery of its own.
use "`here'/../XAA_2015_XHS_v01_M/Data/Stata/XAA_2015_XHS_v01_M_roster.dta", clear

* --- harmonize: the HCL vocabulary --------------------
* Keys are NEVER renamed. They are the linkage contract, and a
* harmonization that renames them silently breaks every merge that
* module_schema promises. Measures are renamed; keys are preserved.
capture rename age        age_years
capture rename educ_years edu_years

* --- derive: a categorical the master does not carry ------------
capture confirm variable age_years
if (_rc==0) {
    gen byte age_grp = 1 + (age_years>=15) + (age_years>=65)
    label define age_grp 1 "0-14" 2 "15-64" 3 "65+", replace
    label values age_grp age_grp
    label variable age_grp "Age group"
}

* --- harmonized variable and value labels -----------------------
capture label variable hhid       "Household identifier"
capture label variable pid        "Person number within household"
capture label variable age_years  "Age in completed years"
capture label variable sex        "Sex"
capture label variable relation   "Relationship to household head"
capture label variable edu_years  "Years of education"

label define hcl_sex 1 "Male" 2 "Female", replace
capture label values sex hcl_sex
label define hcl_rel 1 "Head" 2 "Spouse" 3 "Child" 4 "Other relative" 5 "Non-relative", replace
capture label values relation hcl_rel

label data "XAA 2015 XHS v01 adaptation - SYNTHETIC (datalib_makelib)"


* declared structure -- mirrors module_schema: in datalib.yaml
char _dta[datalib_level]      "person"
char _dta[datalib_keys]       "hhid pid"
char _dta[datalib_parent]     "household"
char _dta[datalib_parentkeys] "hhid"

save "`here'/Data/Stata/XAA_2015_XHS_v01_M_v01_A_HCL_roster.dta", replace
